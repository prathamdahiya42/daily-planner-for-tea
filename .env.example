# ==============================================================================
# Our Little Room - Environment Configuration
# ==============================================================================
# All secrets used by the application. Copy this file to .env.local for local dev.
# Free tiers only: Vercel + Supabase.
# ==============================================================================

# Supabase Project Configuration (Free Tier)
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Used strictly in server-side API routes for challenge validation)
# NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWT Secret (Used to sign custom JWTs carrying room_id and device_id for RLS)
# Find in Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-chars

# Web Push VAPID Keys
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@ourlittleroom.local
